#version 450
// HUD-free Lossless Scaling (nvn_lsfg.h ls_hud): its in-between picture, made from the scene alone, with the HUD of the newest real frame put back on top:
//   where the frame as shown differs from its scene (the HUD drew there), the shown pixel; elsewhere the generated one. Same rule as fg_gen.frag's hud.
//   Raw values throughout (UNORM views of all four images): no sRGB conversion either way.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D gen;     // the in-between picture (Lossless Scaling's; smaller than o when it ran at the 3D render size: filtered up here)
layout(set = 0, binding = 1) uniform sampler2D scene;   // the newest frame's scene (before its HUD pass), o's size
layout(set = 0, binding = 2) uniform sampler2D hud;     // the newest frame as shown
// o: built once per format (OFMT = rgba8 / rgb10_a2 / rgba16f, nvn_lsfg.h ls_hud_pipe), and once without a format for the frame formats GLSL has no name for. Without one
//   the view's format needs STORAGE_WRITE_WITHOUT_FORMAT, which Mali, Xclipse and PowerVR leave off RGBA8 even with the device feature on (simdev, VUID-...-OpTypeImage-07027)
#ifdef OFMT
layout(set = 0, binding = 3, OFMT) uniform writeonly image2D o;
#else
layout(set = 0, binding = 3) uniform writeonly image2D o;
#endif
float max3(vec3 v) { return max(v.x, max(v.y, v.z)); }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), s = imageSize(o);
    if (p.x >= s.x || p.y >= s.y) return;
    vec4 m = textureLod(gen, (vec2(p) + 0.5) / vec2(s), 0.0); vec3 hv = texelFetch(hud, p, 0).rgb, b0 = texelFetch(scene, p, 0).rgb;
    imageStore(o, p, vec4(mix(m.rgb, hv, smoothstep(0.004, 0.02, max3(abs(hv - b0)))), m.a));
}
