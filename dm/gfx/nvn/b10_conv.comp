#version 450
// R11G11B10F <-> RGBA16F texels between buffers on the GPU, for DM_VK_B10_AS_RGBA16's stand-in (nvn_vk.c b10_gpu): the rules of dm/gfx/tex/b10_conv.h, bit for bit
//   (negative and -inf to 0, NaN kept a NaN, +inf kept, round to nearest even, past the largest finite value to it; the expansion exact, alpha 1).
//   mode 0, pack:     RGBA16F texels (two words: R | G << 16, B | A << 16) → packed words in the game's layout (word k0 + z * kimg + y * krow + x)
//   mode 1, expand:   packed words in the game's layout → RGBA16F texels
//   mode 2, quantize: RGBA16F texels → the same values as R11G11B10F stores them, in place (alpha 1)
//   The RGBA16F texels are tight: words h0 + 2 * ((z * h + y) * w + x). Texel i0 + the invocation's index (a big region takes several dispatches).
//   Built into b10_conv_spv.h: glslc --target-env=vulkan1.0 (see that file)
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer H { uint v[]; } hb;
layout(set = 0, binding = 1, std430) buffer K { uint v[]; } kb;
layout(push_constant) uniform P { uint w, h, n, mode, h0, k0, krow, kimg, i0; } p;
uint half_to_chan(uint hv, uint mb) {
    uint e = (hv >> 10) & 31u, m = hv & 1023u, sh = 10u - mb;
    if (e == 31u) return m != 0u ? ((31u << mb) | max(m >> sh, 1u)) : ((hv & 0x8000u) != 0u ? 0u : (31u << mb));
    if ((hv & 0x8000u) != 0u) return 0u;
    uint x = (e << 10) | m, r = x >> sh, rem = x & ((1u << sh) - 1u), hf = 1u << (sh - 1u);
    if (rem > hf || (rem == hf && (r & 1u) != 0u)) r++;
    return r >= (31u << mb) ? (31u << mb) - 1u : r;
}
uint chan_to_half(uint c, uint mb) { return (((c >> mb) & 31u) << 10) | ((c & ((1u << mb) - 1u)) << (10u - mb)); }
void main() {
    uint i = p.i0 + gl_GlobalInvocationID.x; if (i >= p.w * p.h * p.n) return;
    uint x = i % p.w, y = (i / p.w) % p.h, z = i / (p.w * p.h), hi = p.h0 + 2u * i;
    if (p.mode == 1u) {
        uint k = kb.v[p.k0 + z * p.kimg + y * p.krow + x];
        hb.v[hi] = chan_to_half(k & 0x7ffu, 6u) | (chan_to_half((k >> 11) & 0x7ffu, 6u) << 16);
        hb.v[hi + 1u] = chan_to_half(k >> 22, 5u) | (0x3c00u << 16);
        return;
    }
    uint rg = hb.v[hi], ba = hb.v[hi + 1u], r = half_to_chan(rg & 0xffffu, 6u), g = half_to_chan(rg >> 16, 6u), b = half_to_chan(ba & 0xffffu, 5u);
    if (p.mode == 0u) kb.v[p.k0 + z * p.kimg + y * p.krow + x] = r | (g << 11) | (b << 22);
    else { hb.v[hi] = chan_to_half(r, 6u) | (chan_to_half(g, 6u) << 16); hb.v[hi + 1u] = chan_to_half(b, 5u) | (0x3c00u << 16); }
}
